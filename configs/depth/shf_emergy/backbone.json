{
  "preset": "backbone",
  "dataset": "shf_emergy",
  "backbone": "vits",
  "paths": {
    "dataset_root": "${DATA_ROOT}/shf_emergy/moge2",
    "train_index": ".train.txt",
    "val_index": ".val_person_car_active_back_available.txt",
    "workspace": "${OUTPUT_ROOT}/depth/shf_emergy/backbone",
    "init_checkpoint": "${WEIGHTS_ROOT}/depth/moge2_vits.pt",
    "resume_checkpoint": ""
  },
  "data": {
    "width": 640,
    "height": 440,
    "clamp_max_depth": 80.0,
    "min_depth": 1.0,
    "max_depth": 80.0,
    "metric_depth_ranges": [
      [
        1.0,
        10.0
      ],
      [
        1.0,
        20.0
      ],
      [
        1.0,
        80.0
      ]
    ],
    "num_tokens_range": [
      1200,
      3600
    ]
  },
  "train": {
    "num_iterations": 20000,
    "batch_size_forward": 4,
    "gradient_accumulation_steps": 1,
    "precision": "bf16",
    "num_load_workers": 8,
    "num_process_workers": 16,
    "dataloader_buffer_size": 16,
    "validate_every": 1000,
    "best_metric": "abs_rel_1_80m",
    "log_every": 10,
    "find_unused_parameters": true
  },
  "optimizer": {
    "lr": 1e-05,
    "backbone_lr": 1e-06,
    "weight_decay": 0.01
  },
  "lr_scheduler": {
    "warmup_start": 1000,
    "warmup_end": 2000,
    "step_size": 10000,
    "gamma": 0.5
  }
}
